@model LoginExample.ViewModels.CategoryManagementViewModel
@{
    ViewData["Title"] = "分類管理";
}
<h1>分類管理</h1>

@if (User.IsInRole("Admin"))
{
<h3>新增分類</h3>
    <form asp-controller="Categories" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class ="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Create.Name" class="form-label">
                分類名稱
            </label>
            <input asp-for="Create.Name" class="form-control"/>
            <span asp-validation-for="Create.Name" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">
            新增分類
        </button>
    </form>
}

<hr />

<h3>現有分類</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>分類 ID</th>
            <th>分類名稱</th>
            <th>文章數量</th>
            @if (User.IsInRole("Admin"))
            {
                <th>操作</th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var category in Model.Categories)
    {
        <tr>
            <td>@category.Id</td>
            <td>@category.Name</td>
            <td>@category.ArticleCount</td>

            @if (User.IsInRole("Admin"))
            {
                <td>
                    @if (category.Id != 1)
                    {
                        <a asp-controller="Categories"
                           asp-action="Edit"
                           asp-route-id="@category.Id"
                           class="btn btn-primary btn-sm">
                            編輯
                        </a>
                        <a asp-controller="Categories"
                           asp-action="Delete"
                           asp-route-id="@category.Id"
                           class="btn btn-danger btn-sm">
                            刪除
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">系統保留</span>
                    }
                </td>
            }
        </tr>
    }
</tbody>
</table>

@if (User.IsInRole("Admin"))
{
    <hr/>
    <h3>已刪除分類</h3>

    @if (!Model.DeletedCategories.Any())
    {
        <p>目前沒有已刪除的分類</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>分類</th>
                    <th>分類名稱</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.DeletedCategories)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td>@category.Name</td>
                        <td>
                            <form asp-controller="Categories" asp-action="Restore"
                            asp-route-id="@category.Id" method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-success">復原</button>
                        </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

