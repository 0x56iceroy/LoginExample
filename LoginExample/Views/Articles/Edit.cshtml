@model LoginExample.ViewModels.ArticleEditViewModel

@{
    ViewData["Title"] = "Edit Article";
}
<h2>Edit Article</h2>
<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">文章分類</label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Content"></label>
        <textarea asp-for="Content" class="form-control" rows="8"></textarea>
        <span asp-validation-for="Content"></span>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
    </div>
</form>

<a asp-action="Index" class="btn btn-secondary">Back to Articles</a>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}