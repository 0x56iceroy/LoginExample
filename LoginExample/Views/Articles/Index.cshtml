@model IEnumerable<LoginExample.ViewModels.ArticleListItemViewModel>
@{
    ViewData["Title"] = "Articles";
}
@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Articles"
    asp-action="Create"
    class="btn btn-primary">Create Article</a>
}
@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Articles" asp-action="Archived" class="btn btn-secondary">My Archived Articles</a>
}
@if (!Model.Any())
{
    <p>No articles found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>作者</th>
                <th>Created At (UTC)</th>
                <th>操作</th>
            </tr>
            <tbody>
                @foreach (var article in Model)
                {
                    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    <tr>
                        <td>
                            <a asp-controller="Articles" asp-action="Details" asp-route-id="@article.Id">@article.Title</a>
                        </td>
                        <td>@article.AuthorName</td>
                        <td>@article.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (article.AuthorId == currentUserId)
                            {
                                <a asp-controller="Articles" asp-action="Edit" 
                                asp-route-id="@article.Id" class="btn btn-primary btn-sm">編輯</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </thead>
    </table>
}
