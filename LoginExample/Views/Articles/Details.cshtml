@model LoginExample.Models.Article;
@using System.Security.Claims
@using LoginExample.Models
@{
    ViewData["Title"] = Model.Title;
}

<h2>@Model.Title</h2>
<p>
    Create ad:
    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
</p>

<hr />
<div style="white-space: pre-wrap">@Model.Content</div>

<hr />

<a asp-controller="Articles" asp-action="Index">Back to Articles</a>

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Articles"
    asp-action="Edit"
    asp-route-id="@Model.Id">Edit Article</a>
}
@if (Model.AuthorId == User.FindFirstValue(ClaimTypes.NameIdentifier)
&& Model.Status == ArticlesStatus.Published)
{
    <a asp-action="Archive" asp-route-id="@Model.Id" class="btn btn-warning">Archive</a>
}